<Window x:Class="FolderMount.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — FolderMount" Width="470"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        MaxHeight="680"
        ResizeMode="NoResize"
        Background="{DynamicResource BrBgDialog}"
        Foreground="{DynamicResource BrText}"
        FontFamily="{StaticResource FontMain}"
        Style="{StaticResource DialogWindowStyle}">

    <Border BorderBrush="{DynamicResource BrBorderDialog}" BorderThickness="1"
            Background="{DynamicResource BrBgDialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Custom Title bar -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Sleek Top Accent Highlight Line -->
            <Border Grid.Row="0" Height="2" VerticalAlignment="Top" Background="{DynamicResource BrAccent}" Panel.ZIndex="10"/>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Height="40" Background="{DynamicResource BrBgCard}"
                    BorderBrush="{DynamicResource BrBorderSubtle}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="Settings" VerticalAlignment="Center" Margin="24,0,0,0" 
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrText}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕" Style="{StaticResource BtnWindowClose}" FontSize="12"
                                Width="40" Height="40"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Grid>
            </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="28,20,28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0: Section: Appearance -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- 2 -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>  <!-- 4: Section: Startup -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- 6 -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>  <!-- 8: Section: System Integration -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- 10 -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>  <!-- 12: Section: Storage -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- 14 -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>  <!-- 16: Section: Actual Drives -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- 18 -->
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>  <!-- 20: Close -->
                </Grid.RowDefinitions>

                <!-- SECTION: Appearance -->
                <TextBlock Grid.Row="0" Text="APPEARANCE"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrTextMuted}"/>

                <Border Grid.Row="2" Background="{DynamicResource BrBgCard}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="App Theme"
                                       FontWeight="SemiBold" Foreground="{DynamicResource BrText}"/>
                            <TextBlock x:Name="TxtThemeDesc"
                                       Text="Follows Windows system setting."
                                       FontSize="11" Foreground="{DynamicResource BrTextSec}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="CmbTheme"
                                  Style="{StaticResource InputCombo}"
                                  Height="34" Width="160"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  SelectionChanged="CmbTheme_SelectionChanged">
                            <ComboBoxItem Content="💻 Follow Windows"/>
                            <ComboBoxItem Content="🌙 Dark Theme"/>
                            <ComboBoxItem Content="☀️ Light Theme"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- SECTION: Startup -->
                <TextBlock Grid.Row="4" Text="STARTUP"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrTextMuted}"/>

                <Border Grid.Row="6" Background="{DynamicResource BrBgCard}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Run at Windows startup"
                                       FontWeight="SemiBold" Foreground="{DynamicResource BrText}"/>
                            <TextBlock Text="FolderMount will start silently and re-mount all drives on login."
                                       FontSize="11" Foreground="{DynamicResource BrTextSec}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkStartup"
                                  Style="{StaticResource ModernCheck}"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  Checked="ChkStartup_Checked"
                                  Unchecked="ChkStartup_Unchecked"/>
                    </Grid>
                </Border>

                <!-- SECTION: System Integration -->
                <TextBlock Grid.Row="8" Text="SYSTEM INTEGRATION"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrTextMuted}"/>

                <Border Grid.Row="10" Background="{DynamicResource BrBgCard}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Folder Context Menu"
                                       FontWeight="SemiBold" Foreground="{DynamicResource BrText}"/>
                            <TextBlock Text="Add 'Mount as Drive' to the right-click menu for folders in Windows Explorer."
                                       FontSize="11" Foreground="{DynamicResource BrTextSec}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ChkContextMenu"
                                  Style="{StaticResource ModernCheck}"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  Checked="ChkContextMenu_Checked"
                                  Unchecked="ChkContextMenu_Unchecked"/>
                    </Grid>
                </Border>

                <!-- SECTION: Storage -->
                <TextBlock Grid.Row="12" Text="STORAGE"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrTextMuted}"/>

                <Border Grid.Row="14" Background="{DynamicResource BrBgCard}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mappings file location"
                                           FontWeight="SemiBold" Foreground="{DynamicResource BrText}"/>
                                <TextBlock x:Name="TxtMappingPath" FontSize="11"
                                           Foreground="{DynamicResource BrTextSec}"
                                           FontFamily="Consolas"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open Folder"
                                    Style="{StaticResource BtnGhost}" Padding="12,6"
                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                    Click="OpenDataFolder_Click"/>
                        </Grid>
                        <Separator Grid.Row="1" Background="{DynamicResource BrBorderSubtle}"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Backup &amp; Restore"
                                           FontWeight="SemiBold" Foreground="{DynamicResource BrText}"/>
                                <TextBlock Text="Export to or import from a mappings.xml file."
                                           FontSize="11" Foreground="{DynamicResource BrTextSec}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⬇ Import"
                                        Style="{StaticResource BtnGhost}" Padding="12,6"
                                        Margin="12,0,4,0"
                                        Click="QuickImport_Click"/>
                                <Button Content="⬆ Export"
                                        Style="{StaticResource BtnGhost}" Padding="12,6"
                                        Click="QuickExport_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SECTION: Actual Drives & Labels -->
                <TextBlock Grid.Row="16" Text="ACTUAL DRIVES &amp; EXPLORER LABELS"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrTextMuted}"/>

                <Border Grid.Row="18" Background="{DynamicResource BrBgCard}"
                        BorderBrush="{DynamicResource BrBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Virtual Drive Label Optimization"
                                       FontWeight="SemiBold" Foreground="{DynamicResource BrText}"/>
                            <TextBlock Text="Clear host filesystem Volume Labels and use Drive Labels instead so virtual (SUBST) drives display custom names in Windows Explorer."
                                       FontSize="11" Foreground="{DynamicResource BrTextSec}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Manage Drives…"
                                Style="{StaticResource BtnGhost}" Padding="12,6"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                Click="BtnActualDrives_Click"/>
                    </Grid>
                </Border>

                <!-- Close -->
                <Button Grid.Row="20" Content="Close" Style="{StaticResource BtnPrimary}"
                        Padding="16,10" HorizontalAlignment="Right" Click="BtnClose_Click"/>
            </Grid>
        </ScrollViewer>
        </Grid>
    </Border>
</Window>
