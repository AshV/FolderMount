<Window x:Class="FolderMount.AddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Mapping" Height="320" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrBgBase}"
        Foreground="{StaticResource BrText}"
        FontFamily="{StaticResource FontMain}"
        Style="{StaticResource WindowStyle}">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title -->
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>  <!-- Drive letter -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Folder path -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- Label -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" x:Name="TxtDialogTitle"
                   Text="Add Drive Mapping"
                   FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource BrText}"/>

        <!-- Drive Letter -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="DRIVE LETTER"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextSec}"/>
            <ComboBox Grid.Row="2" x:Name="CmbDriveLetter"
                      Style="{StaticResource InputCombo}"
                      Height="36"/>
        </Grid>

        <!-- Folder Path -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="FOLDER PATH"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextSec}"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtFolderPath"
                         Style="{StaticResource InputBox}" Height="36"
                         VerticalContentAlignment="Center"/>
                <Button  Grid.Column="2" Content="Browse…"
                         Style="{StaticResource BtnGhost}" Height="36" Padding="14,0"
                         Click="BrowseFolder_Click"/>
            </Grid>
        </Grid>

        <!-- Label -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="LABEL  (optional)"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextSec}"/>

            <TextBox Grid.Row="2" x:Name="TxtLabel"
                     Style="{StaticResource InputBox}" Height="36"
                     VerticalContentAlignment="Center"
                     x:Uid="TxtLabel"/>
        </Grid>

        <!-- Buttons -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TxtValidation"
                       Foreground="{StaticResource BrDanger}" FontSize="11"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Content="Cancel" Style="{StaticResource BtnGhost}"
                    Padding="18,8" Click="Cancel_Click" IsCancel="True"/>
            <Button Grid.Column="4" x:Name="BtnOk" Content="Save Mapping"
                    Style="{StaticResource BtnPrimary}" Padding="18,8"
                    Click="Ok_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
