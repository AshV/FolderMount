<Window x:Class="FolderMount.AddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Mapping" Width="500"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource BrBgDialog}"
        Foreground="{DynamicResource BrText}"
        FontFamily="{StaticResource FontMain}"
        Style="{StaticResource DialogWindowStyle}">

    <Border BorderBrush="{DynamicResource BrBorderDialog}" BorderThickness="1"
            Background="{DynamicResource BrBgDialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Custom Title bar -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Sleek Top Accent Highlight Line -->
            <Border Grid.Row="0" Height="2" VerticalAlignment="Top" Background="{DynamicResource BrAccent}" Panel.ZIndex="10"/>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Height="40" Background="{DynamicResource BrBgCard}"
                    BorderBrush="{DynamicResource BrBorderSubtle}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="24,0,0,0" 
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrText}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕" Style="{StaticResource BtnWindowClose}" FontSize="12"
                                Width="40" Height="40"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Grid>
            </Border>

        <Grid Grid.Row="1" Margin="28,0,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Folder path -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>  <!-- Drive Letter and Label -->
                <RowDefinition Height="24"/>    <!-- Gap between inputs and buttons -->
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Folder Path -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="FOLDER PATH"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrTextSec}"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtFolderPath"
                             Style="{StaticResource InputBox}" Height="36"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtFolderPath_TextChanged"/>
                    <Button  Grid.Column="2" Content="Browse…"
                             Style="{StaticResource BtnGhost}" Height="36" Padding="14,0"
                             Click="BrowseFolder_Click"/>
                </Grid>
            </Grid>

            <!-- Drive Letter & Label -->
            <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Drive Letter -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DRIVE LETTER"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrTextSec}"/>
                <ComboBox Grid.Row="2" x:Name="CmbDriveLetter"
                          Style="{StaticResource InputCombo}"
                          Height="36" Width="70" HorizontalAlignment="Left"/>
            </Grid>

            <!-- Label -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="LABEL  (optional)"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrTextSec}"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="TxtLabel"
                             Style="{StaticResource InputBox}" Height="36"
                             VerticalContentAlignment="Center"
                             ToolTip="Custom name displayed for this drive in Windows Explorer"
                             TextChanged="TxtLabel_TextChanged"/>

                    <Button Grid.Column="1" x:Name="BtnLabelWarning"
                            Style="{StaticResource BtnBase}"
                            Background="{DynamicResource BrBgElevated}"
                            BorderBrush="{DynamicResource BrWarning}"
                            BorderThickness="1"
                            Width="36" Height="36"
                            Margin="8,0,0,0"
                            Padding="0"
                            Visibility="Collapsed"
                            Click="BtnLabelWarning_Click">
                        <TextBlock Text="⚠️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

            <!-- Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtValidation"
                           Foreground="{DynamicResource BrDanger}" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource BtnGhost}"
                        Padding="18,8" Click="Cancel_Click" IsCancel="True"/>
                <Button Grid.Column="4" x:Name="BtnOk" Content="Save Mapping"
                        Style="{StaticResource BtnPrimary}" Padding="18,8"
                        Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
