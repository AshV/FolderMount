<Window x:Class="FolderMount.AddEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Mapping" Width="500"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BrBgBase}"
        Foreground="{StaticResource BrText}"
        FontFamily="{StaticResource FontMain}"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Custom Title bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Height="40">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="28,0,0,0" 
                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrTextSec}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="✕" Style="{StaticResource BtnWindowClose}" FontSize="12"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="28,0,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Folder path -->
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>  <!-- Drive Letter and Label -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Folder Path -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="FOLDER PATH"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource BrTextSec}"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtFolderPath"
                             Style="{StaticResource InputBox}" Height="36"
                             VerticalContentAlignment="Center"/>
                    <Button  Grid.Column="2" Content="Browse…"
                             Style="{StaticResource BtnGhost}" Height="36" Padding="14,0"
                             Click="BrowseFolder_Click"/>
                </Grid>
            </Grid>

            <!-- Drive Letter & Label -->
            <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Drive Letter -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DRIVE LETTER"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource BrTextSec}"/>
                <ComboBox Grid.Row="2" x:Name="CmbDriveLetter"
                          Style="{StaticResource InputCombo}"
                          Height="36" Width="70" HorizontalAlignment="Left">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="{StaticResource BrBgElevated}" />
                            <Setter Property="Foreground" Value="{StaticResource BrText}" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrBgRowSelect}" />
                                    <Setter Property="Foreground" Value="{StaticResource BrText}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrBgRowSelect}" />
                                    <Setter Property="Foreground" Value="{StaticResource BrText}" />
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrBgRowSelect}" />
                                    <Setter Property="Foreground" Value="{StaticResource BrText}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </Grid>

            <!-- Label -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="LABEL  (optional)"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource BrTextSec}"/>

                <TextBox Grid.Row="2" x:Name="TxtLabel"
                         Style="{StaticResource InputBox}" Height="36"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Grid>

            <!-- Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtValidation"
                           Foreground="{StaticResource BrDanger}" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource BtnGhost}"
                        Padding="18,8" Click="Cancel_Click" IsCancel="True"/>
                <Button Grid.Column="4" x:Name="BtnOk" Content="Save Mapping"
                        Style="{StaticResource BtnPrimary}" Padding="18,8"
                        Click="Ok_Click" IsDefault="True"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
