<Window x:Class="FolderMount.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderMount.ViewModels"
        xmlns:conv="clr-namespace:FolderMount.Converters"
        Title="FolderMount" Height="620" Width="920"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgBase}"
        Foreground="{StaticResource BrText}"
        FontFamily="{StaticResource FontMain}"
        Style="{StaticResource WindowStyle}">

    <Window.Resources>
        <conv:BoolToColorConverter      x:Key="BoolToColor"      />
        <conv:BoolToStatusConverter     x:Key="BoolToStatus"     />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"   />  <!-- DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════
             HEADER
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BrBgCard}"
                BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Accent square icon -->
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource BrAccent}" Margin="0,0,14,0">
                        <TextBlock Text="⊞" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FolderMount" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource BrText}"/>
                        <TextBlock Text="Virtual Drive Manager" FontSize="11"
                                   Foreground="{StaticResource BrTextSec}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header stats -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Border Background="{StaticResource BrBgElevated}" CornerRadius="8"
                            Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrSuccess}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtActiveCount"
                                       Text="{Binding ActiveCount, StringFormat='{}{0} Active'}"
                                       FontSize="12" Foreground="{StaticResource BrTextSec}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrBgElevated}" CornerRadius="8" Padding="12,6">
                        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} Total'}"
                                   FontSize="12" Foreground="{StaticResource BrTextSec}"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             TOOLBAR
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource BrBgSurface}"
                BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Primary actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="＋  Add Mapping" Style="{StaticResource BtnPrimary}"
                            Command="{Binding AddCommand}" Margin="0,0,8,0"
                            ToolTip="Add a new folder → drive mapping"/>

                    <Button Content="✎  Edit" Style="{StaticResource BtnGhost}"
                            Command="{Binding EditCommand}" Margin="0,0,6,0"
                            ToolTip="Edit selected mapping"/>

                    <Button Content="🗑  Remove" Style="{StaticResource BtnDanger}"
                            Command="{Binding RemoveCommand}" Margin="0,0,16,0"
                            ToolTip="Remove selected mapping"/>

                    <Rectangle Width="1" Fill="{StaticResource BrBorder}" Margin="0,4,16,4"/>

                    <Button Content="⚡ Mount" Style="{StaticResource BtnGhost}"
                            Command="{Binding MountCommand}" Margin="0,0,6,0"
                            ToolTip="Mount selected drive"/>

                    <Button Content="⏏ Disconnect" Style="{StaticResource BtnGhost}"
                            Command="{Binding UnmountCommand}" Margin="0,0,6,0"
                            ToolTip="Disconnect selected drive (keeps mapping saved)"/>

                    <Button Content="⚡ Mount All" Style="{StaticResource BtnGhost}"
                            Command="{Binding MountAllCommand}" Margin="0,0,6,0"
                            ToolTip="Mount all inactive drives"/>

                    <Button Content="⏏ Disconnect All" Style="{StaticResource BtnGhost}"
                            Command="{Binding UnmountAllCommand}" Margin="0,0,6,0"
                            ToolTip="Disconnect all active drives"/>

                    <Button Content="📂 Open in Explorer" Style="{StaticResource BtnGhost}"
                            Command="{Binding OpenExplorerCommand}" Margin="0,0,0,0"
                            ToolTip="Open selected drive in Windows Explorer"/>
                </StackPanel>

                <!-- Right: Import / Export / Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⬆ Export" Style="{StaticResource BtnGhost}"
                            Command="{Binding ExportCommand}" Margin="0,0,6,0"
                            ToolTip="Export mappings to XML file"/>

                    <Button Content="⬇ Import" Style="{StaticResource BtnGhost}"
                            Command="{Binding ImportCommand}" Margin="0,0,6,0"
                            ToolTip="Import mappings from XML file"/>

                    <Button Content="↻" Style="{StaticResource BtnIcon}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh drive status" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             DATAGRID
        ═══════════════════════════════════════════════ -->
        <DataGrid Grid.Row="2"
                  x:Name="MappingGrid"
                  Style="{StaticResource ModernGrid}"
                  ColumnHeaderStyle="{StaticResource GridColHeader}"
                  RowStyle="{StaticResource GridRow}"
                  CellStyle="{StaticResource GridCell}"
                  ItemsSource="{Binding Mappings}"
                  SelectedItem="{Binding SelectedMapping, Mode=TwoWay}"
                  Margin="16,12,16,4">

            <DataGrid.Columns>

                <!-- STATUS DOT -->
                <DataGridTemplateColumn Header="STATUS" Width="80" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                         Fill="{Binding IsActive, Converter={StaticResource BoolToColor}}"/>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatus}}"
                                           FontSize="11"
                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToColor}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- DRIVE LETTER -->
                <DataGridTemplateColumn Header="DRIVE" Width="80" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrBgElevated}"
                                    CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding DisplayLetter}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrAccent}"
                                           FontFamily="Consolas"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- FOLDER PATH -->
                <DataGridTextColumn Header="FOLDER PATH" Width="*" IsReadOnly="True"
                                    Binding="{Binding FolderPath}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource BrText}"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize"   Value="12"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- LABEL -->
                <DataGridTextColumn Header="LABEL" Width="180" IsReadOnly="True"
                                    Binding="{Binding Label}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource BrTextSec}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- ACTIONS (inline buttons) -->
                <DataGridTemplateColumn Header="ACTIONS" Width="200" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Mount (shown when inactive) -->
                                <Button Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11"
                                        Margin="0,0,4,0"
                                        Command="{Binding DataContext.MountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                        Content="⚡ Mount" ToolTip="Mount this drive"/>
                                <!-- Eject (shown when active) -->
                                <Button Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11"
                                        Margin="0,0,4,0"
                                        Command="{Binding DataContext.UnmountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"
                                        Content="⏏ Eject" ToolTip="Disconnect this drive"/>
                                <!-- Open Explorer -->
                                <Button Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11"
                                        Command="{Binding DataContext.OpenExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        IsEnabled="{Binding IsActive}"
                                        Content="📂" ToolTip="Open in Explorer"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state message -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding TotalCount, Converter={StaticResource BoolToVisibility}, ConverterParameter=zeroIsVisible}">
            <TextBlock Text="⊞" FontSize="48" Foreground="{StaticResource BrBorderSubtle}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="No drive mappings yet" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource BrTextMuted}" HorizontalAlignment="Center"/>
            <TextBlock Text="Click ＋ Add Mapping to map a folder to a drive letter"
                       FontSize="12" Foreground="{StaticResource BrTextMuted}"
                       HorizontalAlignment="Center" Margin="0,6,0,20"/>
            <Button Content="＋  Add Your First Mapping" Style="{StaticResource BtnPrimary}"
                    Command="{Binding AddCommand}" HorizontalAlignment="Center" Padding="20,10"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════
             STATUS BAR
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource BrBgCard}"
                BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrTextSec}" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TotalCount, StringFormat='{}Mappings: {0}'}"
                           Foreground="{StaticResource BrTextMuted}" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
