<Window x:Class="FolderMount.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderMount.ViewModels"
        xmlns:conv="clr-namespace:FolderMount.Converters"
        Title="FolderMount" Height="620" Width="920"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgBase}"
        Foreground="{StaticResource BrText}"
        FontFamily="{StaticResource FontMain}"
        Style="{StaticResource WindowStyle}">

    <Window.Resources>
        <conv:IntToVisibilityConverter x:Key="IntToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"   />  <!-- DataGrid -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════
             HEADER
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BrBgCard}"
                BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Application Logo -->
                    <Image Source="pack://application:,,,/Assets/icon.ico" 
                           Width="38" Height="38" Margin="0,0,14,0" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FolderMount" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource BrText}"/>
                        <TextBlock Text="Virtual Drive Manager" FontSize="11"
                                   Foreground="{StaticResource BrTextSec}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header stats & Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-18,-24,0">
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,18,10,0">
                        <Border Background="{StaticResource BrBgElevated}" CornerRadius="8"
                                Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrSuccess}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtActiveCount"
                                           Text="{Binding ActiveCount, StringFormat='{}{0} Active'}"
                                           FontSize="12" Foreground="{StaticResource BrTextSec}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BrBgElevated}" CornerRadius="8" Padding="12,6">
                            <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} Total'}"
                                       FontSize="12" Foreground="{StaticResource BrTextSec}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Height="40">
                        <Button Content="—" Style="{StaticResource BtnWindowControl}" FontSize="12"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="☐" Style="{StaticResource BtnWindowControl}" FontSize="14" Margin="0,0,0,2"
                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="✕" Style="{StaticResource BtnWindowClose}" FontSize="12"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             TOOLBAR
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource BrBgSurface}"
                BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Primary actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="＋  Add Mapping" Style="{StaticResource BtnPrimary}"
                            Command="{Binding AddCommand}" Margin="0,0,16,0"
                            ToolTip="Add a new folder → drive mapping"/>

                    <Rectangle Width="1" Fill="{StaticResource BrBorderSubtle}" Margin="0,4,16,4"/>

                    <Button Content="⚡ Mount All" Style="{StaticResource BtnGhost}"
                            Command="{Binding MountAllCommand}" Margin="0,0,6,0"
                            ToolTip="Mount all inactive drives"/>

                    <Button Content="⏏ Disconnect All" Style="{StaticResource BtnGhost}"
                            Command="{Binding UnmountAllCommand}" Margin="0,0,6,0"
                            ToolTip="Disconnect all active drives"/>
                </StackPanel>

                <!-- Right: Settings & Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⚙ Settings" Style="{StaticResource BtnGhost}"
                            Click="BtnSettings_Click" Margin="0,0,6,0"
                            ToolTip="Open settings and storage options"/>

                    <Button Content="↻" Style="{StaticResource BtnIcon}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh drive status" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             DATAGRID
        ═══════════════════════════════════════════════ -->
        <DataGrid Grid.Row="2"
                  x:Name="MappingGrid"
                  Style="{StaticResource ModernGrid}"
                  ColumnHeaderStyle="{StaticResource GridColHeader}"
                  RowStyle="{StaticResource GridRow}"
                  CellStyle="{StaticResource GridCell}"
                  ItemsSource="{Binding Mappings}"
                  SelectedItem="{Binding SelectedMapping, Mode=TwoWay}"
                  Margin="16,12,16,4">

            <DataGrid.Columns>

                <!-- STATUS DOT — binds directly to model properties -->
                <DataGridTemplateColumn Header="STATUS" Width="80" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                         Fill="{Binding StatusBrush}"/>
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="11"
                                           Foreground="{Binding StatusBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- DRIVE LETTER -->
                <DataGridTemplateColumn Header="DRIVE" Width="80" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrBgElevated}"
                                    CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding DisplayLetter}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrAccent}"
                                           FontFamily="Consolas"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- FOLDER PATH -->
                <DataGridTextColumn Header="FOLDER PATH" Width="*" IsReadOnly="True"
                                    Binding="{Binding FolderPath}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource BrText}"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize"   Value="12"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- LABEL -->
                <DataGridTextColumn Header="LABEL" Width="180" IsReadOnly="True"
                                    Binding="{Binding Label}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource BrTextSec}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- ACTIONS (inline buttons) — uses model Visibility properties -->
                <DataGridTemplateColumn Header="ACTIONS" Width="260" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Mount/Eject (Primary contextual action) -->
                                <Button Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                        Command="{Binding DataContext.MountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding MountVisibility}"
                                        Content="⚡ Mount" ToolTip="Mount this drive"/>
                                <Button Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                        Command="{Binding DataContext.UnmountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding UnmountVisibility}"
                                        Content="⏏ Eject" ToolTip="Disconnect this drive"/>
                                
                                <Rectangle Width="1" Fill="{StaticResource BrBorderSubtle}" Margin="4,2,8,2"/>

                                <!-- Secondary Actions -->
                                <Button Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                        Command="{Binding DataContext.OpenExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsActive}"
                                        Content="📂" ToolTip="Open in Explorer"/>
                                <Button Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11" Margin="0,0,4,0"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="✎" ToolTip="Edit this mapping"/>
                                <Button Style="{StaticResource BtnGhost}" Padding="8,4" FontSize="11" Margin="0,0,0,0"
                                        Foreground="{StaticResource BrDanger}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="🗑" ToolTip="Remove this mapping"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state message -->
        <Border Grid.Row="2" Background="{StaticResource BrBgSurface}" CornerRadius="12"
                Margin="32" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="1"
                Visibility="{Binding TotalCount, Converter={StaticResource IntToVisibility}, ConverterParameter=zeroIsVisible}">
            <StackPanel>
                <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource BrBgElevated}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="⊞" FontSize="32" Foreground="{StaticResource BrAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No mappings yet" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource BrText}" HorizontalAlignment="Center"/>
                <TextBlock Text="Map any local folder to a virtual drive letter for quick access."
                           FontSize="13" Foreground="{StaticResource BrTextSec}"
                           HorizontalAlignment="Center" Margin="0,8,0,24"/>
                <Button Content="＋  Add Your First Mapping" Style="{StaticResource BtnPrimary}"
                        Command="{Binding AddCommand}" HorizontalAlignment="Center" Padding="24,12" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════
             STATUS BAR
        ═══════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource BrBgCard}"
                BorderBrush="{StaticResource BrBorderSubtle}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrTextSec}" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TotalCount, StringFormat='{}Mappings: {0}'}"
                           Foreground="{StaticResource BrTextMuted}" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
