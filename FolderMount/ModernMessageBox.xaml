<Window x:Class="FolderMount.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderMount"
        Width="440" MinWidth="380" MaxWidth="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrBgDialog}"
        Foreground="{DynamicResource BrText}"
        FontFamily="{StaticResource FontMain}"
        Style="{StaticResource DialogWindowStyle}">

    <Border BorderBrush="{DynamicResource BrBorderDialog}" BorderThickness="1"
            Background="{DynamicResource BrBgDialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Custom Title bar -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Sleek Top Accent Highlight Line -->
            <Border x:Name="TopAccentLine" Grid.Row="0" Height="2" VerticalAlignment="Top" 
                    Background="{DynamicResource BrAccent}" Panel.ZIndex="10"/>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Height="40" Background="{DynamicResource BrBgCard}"
                    BorderBrush="{DynamicResource BrBorderSubtle}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                               VerticalAlignment="Center" Margin="20,0,0,0" 
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrText}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕" Style="{StaticResource BtnWindowClose}" FontSize="12"
                                Width="40" Height="40"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Icon + Message -->
                    <RowDefinition Height="24"/>    <!-- Spacer -->
                    <RowDefinition Height="Auto"/>  <!-- Buttons -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Container -->
                    <Border x:Name="IconBadge" Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                            VerticalAlignment="Top" Margin="0,2,16,0"
                            Background="{DynamicResource BrBgCard}"
                            BorderBrush="{DynamicResource BrBorderSubtle}" BorderThickness="1">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="IconPath" Fill="{DynamicResource BrAccent}" Stretch="Uniform" />
                        </Viewbox>
                    </Border>

                    <!-- Message text -->
                    <TextBlock Grid.Column="1" x:Name="TxtMessage"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{DynamicResource BrText}"
                               LineHeight="20"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Button Strip -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource BtnGhost}"
                            MinWidth="84" Height="32" Padding="14,4" Margin="0,0,8,0"
                            Click="BtnCancel_Click" IsCancel="True" Visibility="Collapsed"/>
                    <Button x:Name="BtnNo" Content="No" Style="{StaticResource BtnGhost}"
                            MinWidth="84" Height="32" Padding="14,4" Margin="0,0,8,0"
                            Click="BtnNo_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnYes" Content="Yes" Style="{StaticResource BtnPrimary}"
                            MinWidth="84" Height="32" Padding="14,4" Margin="0,0,8,0"
                            Click="BtnYes_Click" IsDefault="True" Visibility="Collapsed"/>
                    <Button x:Name="BtnOk" Content="OK" Style="{StaticResource BtnPrimary}"
                            MinWidth="84" Height="32" Padding="14,4"
                            Click="BtnOk_Click" IsDefault="True" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
